<resources>
    <!-- Android 12+ splash: the launcher icon on MeaVox black instead of the system default. -->
    <style name="Theme.MeaVox" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/meavox_bg</item>
        <item name="android:colorAccent">@color/meavox_gold</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/meavox_bg</item>
    </style>
</resources>
